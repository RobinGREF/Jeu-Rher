# Modèle de app/.env (voir docs/en-ligne.md). Ces valeurs sont publiques : les règles de la base protègent les données.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Pour essayer sans Firebase, dans deux onglets d'un même navigateur (à la place des lignes ci-dessus) :
# EXPO_PUBLIC_ONLINE_BACKEND=local
